# Application Settings
PROJECT_NAME="HackFlow Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# CORS Origins (JSON array of strings)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'

# Database Configuration (Local SQLite default / Local or Supabase PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./hackflow.db"

# JWT Security
SECRET_KEY="hackflow9-super-secret-key-development-minimum-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub OAuth Credentials (for HF-19)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:5173/auth/callback"
