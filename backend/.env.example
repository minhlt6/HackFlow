# App Configuration
APP_ENV=development
APP_NAME=HackFlow
DEBUG=True
SECRET_KEY=hackflow-super-secret-key-must-be-min-32-chars-long!
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Connection (PostgreSQL on Supabase, or fallback to sqlite for dev/test)
# Example Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./hackflow_dev.db

# JWT Settings
JWT_SECRET_KEY=hackflow-jwt-super-secret-key-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# Cloud / Supabase Storage (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key
